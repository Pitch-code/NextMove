    <string name="voice_button">குரலில் சொல்லுங்கள்</string>
    <string name="voice_title">என்ன நடந்தது சொல்லுங்கள்</string>
    <string name="voice_body">உங்கள் சொந்த வார்த்தைகளில் பேசுங்கள் அல்லது தட்டச்சு செய்யுங்கள். அவர்கள் என்ன செய்யச் சொன்னார்கள், எப்படி தொடர்பு கொண்டார்கள், பணம் அனுப்பப்பட்டதா என்பதைக் குறிப்பிடுங்கள்.</string>
    <string name="start_listening">பேசத் தொடங்குங்கள்</string>
    <string name="check_situation">இந்த சூழ்நிலையைச் சரிபார்க்கவும்</string>
    <string name="safe_next_steps">பாதுகாப்பான அடுத்த படிகள்</string>
    <string name="safe_step_1">தொடர்பை நிறுத்துங்கள்; லிங்க்கைத் தட்டவோ, OTP, CVV, UPI PIN அல்லது கடவுச்சொல்லைப் பகிரவோ வேண்டாம்.</string>
    <string name="safe_step_2">நிறுவனத்தின் அதிகாரப்பூர்வ வலைதளம், ஆப் அல்லது எண் மூலம் சரிபார்க்கவும் — செய்தியில் உள்ளதை நம்பாதீர்கள்.</string>
    <string name="safe_step_3">பணம் அனுப்பியிருந்தால், உடனே வங்கியைத் தொடர்பு கொண்டு இந்தியாவின் சைபர் மோசடி ஹெல்ப்லைன் 1930-ஐ அழைக்கவும்.</string>
    <string name="call_1930">1930 சைபர் ஹெல்ப்லைனை அழைக்கவும்</string>
    <string name="report_cybercrime">அதிகாரப்பூர்வ புகார் தளத்தைத் திறக்கவும்</string>

