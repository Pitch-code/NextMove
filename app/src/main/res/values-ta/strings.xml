    <string name="tagline">"பின்பு" என்பதிலிருந்து "முடிந்தது" வரை.</string>
    <string name="home_eyebrow">உங்கள் அமைதியான செயல் இடம்</string>
    <string name="home_title">உங்கள் மனதில் என்ன நிற்கிறது?</string>
    <string name="home_body">ஒரு ஸ்கிரீன்ஷாட்டைப் பகிரவும். முக்கியமானதை NextMove ஒரு தெளிவான, பாதுகாப்பான செயலாக மாற்றும்.</string>
    <string name="share_title">ஒரு ஸ்கிரீன்ஷாட்டைப் பகிரவும்</string>
    <string name="share_body">பில்கள், அப்பாயிண்ட்மென்ட், ரிட்டர்ன் அல்லது சந்தேகமான செய்திகள்.</string>
    <string name="choose_image">போனிலிருந்து தேர்வு செய்யவும்</string>
