    <string name="panic_eyebrow">அவசர உதவி</string>
    <string name="panic_title">விரைவாகவும் பாதுகாப்பாகவும் செயல்படுவோம்</string>
    <string name="panic_body">இப்போதே இந்தப் படிகளைப் பின்பற்றுங்கள். அமைதியாக விரைந்து செயல்படுவது சேதத்தைக் குறைக்கும்.</string>
    <string name="panic_steps_label">இப்போதே இதைச் செய்யுங்கள்</string>
    <string name="panic_step_1">எல்லா தொடர்பையும் நிறுத்துங்கள். மேலும் பணம் தரவோ, OTP பகிரவோ, அவர்கள் சொல்லும் எந்த ஆப்பையும் நிறுவவோ வேண்டாம்.</string>
    <string name="panic_step_2">பணம் அனுப்பியிருந்தால், உடனே வங்கியை அழைத்து கார்டு அல்லது UPI-ஐ முடக்குங்கள்.</string>
    <string name="panic_step_3">புகார் அளிக்க இந்தியாவின் சைபர் மோசடி ஹெல்ப்லைன் 1930-ஐ அழைக்கவும்.</string>
    <string name="panic_step_4">எல்லா விவரங்களுடனும் cybercrime.gov.in இல் புகார் பதிவு செய்யவும்.</string>
    <string name="panic_step_5">ஏதேனும் கடவுச்சொல் அல்லது UPI PIN பகிர்ந்திருந்தால் மாற்றுங்கள், நம்பகமானவரிடம் சொல்லுங்கள்.</string>

    <string name="checker_eyebrow">எண் &amp; லிங்க் சரிபார்ப்பு</string>
    <string name="checker_title">சந்தேகமான எண் அல்லது லிங்க்கைச் சரிபார்க்கவும்</string>
    <string name="checker_body">ஒரு ஃபோன் எண் அல்லது லிங்க்கை ஒட்டவும். NextMove அதை உங்கள் போனில் பொதுவான மோசடி முறைகளுக்காகச் சரிபார்க்கும்.</string>
